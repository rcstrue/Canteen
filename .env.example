# ═══════════════════════════════════════════════════════
# RCS Canteen - Environment Variables Template
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════

# MySQL Database Connection
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# 
# For cPanel/Shared Hosting:
#   - USERNAME: Your cPanel MySQL user (e.g., rcsfaxhz_canteen)
#   - PASSWORD: The password you set in MySQL Databases section
#   - HOST: Usually localhost
#   - PORT: Usually 3306
#   - DATABASE_NAME: Your database name (e.g., rcsfaxhz_canteen)
#
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/DATABASE_NAME"

# NextAuth Secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-string"

# NextAuth URL (your site URL in production)
NEXTAUTH_URL="http://localhost:3000"
