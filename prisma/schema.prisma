generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("staff") // admin, store, kitchen, staff
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?  // denormalized for quick display
  userRole    String?  // denormalized
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, BULK_DELETE, etc.
  entityType  String   // Ingredient, Recipe, Purchase, Supplier, Expense, User, Budget, DailyMeal, StockMovement
  entityId    String?  // ID of affected entity
  entityName  String?  // Human-readable name (e.g., "Rice (Basmati)", "PUR-001")
  description String   // Human-readable description
  metadata    String?  // JSON string with before/after values
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

model Ingredient {
  id               String   @id @default(cuid())
  name             String
  unit             String   // kg, litre, pcs, gram, etc.
  category         String   // Vegetables, Grains, Oil, Spices, Dairy, Meat, etc.
  currentStock     Float    @default(0)
  minStock         Float    @default(0) // par level / minimum stock level
  lastPurchasePrice Float   @default(0) // per unit
  avgCost          Float    @default(0) // average cost per unit
  supplier         String?  // legacy free-text supplier name (kept for backward compat)
  supplierId       String?  // FK to Supplier (preferred way to link)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplierLink     Supplier? @relation(fields: [supplierId], references: [id])

  recipeIngredients RecipeIngredient[]
  stockMovements    StockMovement[]
  purchases         PurchaseItem[]
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  gstin          String?  // GST number for Indian businesses
  category       String?  // what they supply: Grains, Vegetables, etc.
  rating         Int?     // 1-5 star rating (manual override)
  onTimeRate     Float?   // 0-100 percentage (calculated or manual)
  qualityScore   Int?     // 1-5 score (manual)
  notes          String?  // internal notes about supplier
  lastOrderDate  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ingredients Ingredient[]
  purchases   Purchase[]
}

model Recipe {
  id          String   @id @default(cuid())
  name        String
  description String?
  mealType    String   // Breakfast, Lunch, Dinner, Snack
  baseServings Int     @default(100) // base number of servings
  instructions String?
  imageUrl    String?  // Optional: path to recipe image in /public/uploads/recipes/
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients RecipeIngredient[]
  dailyMeals  DailyMealServed[]
  costHistory RecipeCostHistory[]
}

model RecipeCostHistory {
  id          String   @id @default(cuid())
  recipeId    String
  cost        Float    // total cost for baseServings at time of recording
  costPerServing Float // cost / baseServings
  servings    Int      // snapshot of recipe.baseServings at time of recording
  trigger     String   @default("manual") // manual, ingredient_price_change, recipe_edit
  notes       String?
  createdAt   DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([createdAt])
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float   // quantity per base serving batch
  unit         String  // unit for this ingredient in recipe

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
}

model StockMovement {
  id           String   @id @default(cuid())
  ingredientId String
  type         String   // PURCHASE, CONSUMPTION, WASTAGE, ADJUSTMENT
  quantity     Float
  unitPrice    Float    @default(0)
  totalAmount  Float    @default(0)
  date         DateTime
  notes        String?
  referenceId  String?  // link to purchase or daily meal
  createdAt    DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model DailyMealServed {
  id          String   @id @default(cuid())
  date        DateTime
  mealType    String   // Breakfast, Lunch, Dinner
  mealsServed Int
  recipeId    String
  notes       String?
  createdAt   DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id])
}

model Purchase {
  id          String   @id @default(cuid())
  date        DateTime
  supplier    String?  // legacy free-text supplier name (kept for backward compat)
  supplierId  String?  // FK to Supplier (preferred way to link)
  invoiceNo   String?
  totalAmount Float    @default(0)
  notes       String?
  deliveryDate DateTime?  // actual delivery date (if different from order date)
  expectedDate DateTime?  // expected delivery date
  status      String   @default("received") // received, pending, cancelled
  createdAt   DateTime @default(now())

  supplierLink Supplier? @relation(fields: [supplierId], references: [id])
  items PurchaseItem[]
}

model PurchaseItem {
  id           String  @id @default(cuid())
  purchaseId   String
  ingredientId String
  quantity     Float
  unitPrice    Float
  totalAmount  Float

  purchase   Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  category    String   // Gas, Electricity, Water, Maintenance, Other
  amount      Float
  description String?
  createdAt   DateTime @default(now())
}

model Budget {
  id              String   @id @default(cuid())
  month           String   @unique // Format: "2026-07" (YYYY-MM)
  foodBudget      Float    @default(0) // Monthly food budget
  operatingBudget Float    @default(0) // Monthly operating budget (food + expenses)
  totalBudget     Float    @default(0) // Total monthly budget
  alertThreshold  Float    @default(80) // Alert at 80% utilization
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
